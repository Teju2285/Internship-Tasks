#include <iostream>
#include <string>
using namespace std;

struct Book {
    string title;
    string author;
    int year;
};

int main() {

    Book books[100];
    int bookCount = 0;
    int choice;

    do {
        cout << "\n==============================" << endl;
        cout << "       MINI LIBRARY SYSTEM" << endl;
        cout << "==============================" << endl;
        cout << "1. Add New Book" << endl;
        cout << "2. Display All Books" << endl;
        cout << "3. Search Book by Title" << endl;
        cout << "4. Exit" << endl;
        cout << "Enter your choice: ";
        cin >> choice;

        cin.ignore();

        // Add a new book
        if (choice == 1) {

            if (bookCount >= 100) {
                cout << "Library is full!" << endl;
            }
            else {
                cout << "\nEnter book title: ";
                getline(cin, books[bookCount].title);

                cout << "Enter author name: ";
                getline(cin, books[bookCount].author);

                cout << "Enter publication year: ";
                cin >> books[bookCount].year;

                bookCount++;

                cout << "\nBook added successfully!" << endl;
            }
        }

        // Display all books
        else if (choice == 2) {

            if (bookCount == 0) {
                cout << "\nNo books available in the library." << endl;
            }
            else {
                cout << "\n========== ALL BOOKS ==========" << endl;

                for (int i = 0; i < bookCount; i++) {
                    cout << "\nBook " << i + 1 << endl;
                    cout << "Title  : " << books[i].title << endl;
                    cout << "Author : " << books[i].author << endl;
                    cout << "Year   : " << books[i].year << endl;
                }
            }
        }

        // Search book by title
        else if (choice == 3) {

            if (bookCount == 0) {
                cout << "\nNo books available to search." << endl;
            }
            else {
                string searchTitle;
                bool found = false;

                cout << "\nEnter book title to search: ";
                getline(cin, searchTitle);

                for (int i = 0; i < bookCount; i++) {

                    if (books[i].title == searchTitle) {
                        cout << "\nBook Found!" << endl;
                        cout << "Title  : " << books[i].title << endl;
                        cout << "Author : " << books[i].author << endl;
                        cout << "Year   : " << books[i].year << endl;

                        found = true;
                        break;
                    }
                }

                if (!found) {
                    cout << "\nBook not found." << endl;
                }
            }
        }

        // Exit
        else if (choice == 4) {
            cout << "\nThank you for using the Mini Library System!" << endl;
        }

        else {
            cout << "\nInvalid choice. Please try again." << endl;
        }

    } while (choice != 4);

    return 0;
}
